{
    "name": "dy-autoparts-wms",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx server.ts",
        "sync:version": "node scripts/sync-app-version.mjs",
        "build": "npm run sync:version && npm run check:encoding && vite build",
        "preview": "vite preview",
        "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
        "check:encoding": "node scripts/verify-text-repair.mjs",
        "lint": "tsc --noEmit"
    },
    "dependencies": {
        "@sentry/browser": "^10.70.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.14.0",
        "express": "^4.21.2",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "vite": "6.4.2"
    },
    "overrides": {
        "serialize-javascript": "^7.0.5"
    }
}
